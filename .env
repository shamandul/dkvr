POSTGRES_DB=drupal
POSTGRES_USER=drupal
POSTGRES_PASSWORD=drupal_password
DRUPAL_IMAGE=drupal:11-apache
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=apache/kafka:4.0.0
VARNISH_IMAGE=varnish:7.7

# Repositorio de GitHub con el docroot de Drupal (obligatorio para el build)
DRUPAL_GIT_URL=https://github.com/shamandul/dkvr.git
DRUPAL_GIT_REF=v1.0.1

# Generacion de sites/default/settings.php: auto | force | skip
# force: el settings.php del repo esta vacio ($databases=[], hash_salt=''),
# se sustituye por la plantilla configurada por variables de entorno.
DRUPAL_SETTINGS_MODE=force
# 'drupal' se añade para poder verificar/habilitar modulos desde el contenedor
# de Jenkins via la red de compose (http://drupal con Host: drupal).
DRUPAL_TRUSTED_HOSTS=drupal.local,localhost,127.0.0.1,drupal
DRUPAL_HASH_SALT=
DRUPAL_DB_PORT=5432

# Jenkins (servicio con profile "ci", ver README)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=Kafka123!
# GID del grupo docker del host (acceso al socket desde el contenedor)
DOCKER_GID=958
